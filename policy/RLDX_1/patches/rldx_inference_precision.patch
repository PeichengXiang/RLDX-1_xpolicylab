diff --git a/rldx/policy/policy_loader.py b/rldx/policy/policy_loader.py
index ce5b61f..d45a194 100644
--- a/rldx/policy/policy_loader.py
+++ b/rldx/policy/policy_loader.py
@@ -164,12 +164,22 @@ def _load_model(
     """Load model + optionally disable memory inference; return in eval mode."""
     config = AutoConfig.from_pretrained(model_dir, trust_remote_code=True)

-    if getattr(config, "use_memory", False) and deactivate_memory:
+    # This flag preserves FP32 master parameters during backbone training.
+    # Applying it while constructing the inference model overrides the BF16
+    # checkpoint dtype (HF loads each tensor using the constructed parameter's
+    # dtype), even when from_pretrained receives torch_dtype=bfloat16. Normalize
+    # the in-memory inference config before construction; keep the saved
+    # checkpoint and the training constructor unchanged.
+    config.backbone_trainable_params_fp32 = False
+
+    if deactivate_memory:
         print("[RLDXPolicy] deactivate_memory=True: disabling memory for inference...")
         config.use_memory = False
         config.concat_memory = False

-    model = AutoModel.from_pretrained(model_dir, device_map=device, torch_dtype=torch.bfloat16)
+    model = AutoModel.from_pretrained(
+        model_dir, config=config, device_map=device, torch_dtype=torch.bfloat16
+    )
     model.eval()
     return model

diff --git a/tests/test_inference_precision.py b/tests/test_inference_precision.py
new file mode 100644
index 0000000..db34dfa
--- /dev/null
+++ b/tests/test_inference_precision.py
@@ -0,0 +1,165 @@
+"""CPU regression: real RLDX adapter and HF loading, tiny backbone weights."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+
+from contextlib import contextmanager
+from unittest.mock import patch
+import unittest
+import tempfile
+import torch
+from torch import nn
+from transformers import AutoConfig, AutoModel, PretrainedConfig, PreTrainedModel
+from rldx.model.modules.backbone import adapter, modeling_vtc
+
+spec = importlib.util.spec_from_file_location("precision_candidate_loader", os.environ.get("RLDX_TEST_LOADER", str(Path(__file__).resolve().parents[1]/"rldx/policy/policy_loader.py")))
+loader = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = loader
+spec.loader.exec_module(loader)
+
+
+class TinyConfig(PretrainedConfig):
+    model_type = "rldx_precision_regression"
+
+    def __init__(self, backbone_trainable_params_fp32=True, tune_llm=True,
+                 tune_visual=True, use_memory=False, concat_memory=False, **kwargs):
+        super().__init__(**kwargs)
+        self.backbone_trainable_params_fp32 = backbone_trainable_params_fp32
+        self.tune_llm = tune_llm
+        self.tune_visual = tune_visual
+        self.use_memory = use_memory
+        self.concat_memory = concat_memory
+
+
+class TinyVTC(nn.Module):
+    def __init__(self):
+        super().__init__()
+        language = nn.Module()
+        language.config = SimpleNamespace(hidden_size=8)
+        language.embed_tokens = nn.Embedding(17, 8)
+        language.layers = nn.ModuleList([nn.Linear(8, 8), nn.Linear(8, 8)])
+        visual = nn.Module()
+        visual.proj = nn.Linear(8, 8)
+        visual.motion_block = nn.Sequential(nn.BatchNorm2d(2))
+        self.model = nn.Module()
+        self.model.language_model = language
+        self.model.visual = visual
+        self.lm_head = nn.Linear(8, 17)
+        self.register_buffer("integer_marker", torch.tensor([7], dtype=torch.int64))
+
+    @classmethod
+    def _from_config(cls, config):
+        return cls()
+
+
+class TinyPolicy(PreTrainedModel):
+    config_class = TinyConfig
+
+    def __init__(self, config):
+        super().__init__(config)
+        # Use the production constructor, including trainability and casting.
+        self.backbone = adapter.VTCQwen3VLBackbone(
+            model_name="__tiny_rldx_backbone__", tune_llm=config.tune_llm,
+            tune_visual=config.tune_visual, tune_top_llm_layers=1,
+            select_layer=2, load_bf16=True,
+            trainable_params_fp32=config.backbone_trainable_params_fp32,
+            use_cog_tokens=True, n_cog_tokens=2, skip_pretrained_weights=True,
+        )
+        self.action_model = nn.Linear(8, 2)
+
+
+@contextmanager
+def tiny_backbone():
+    original = AutoConfig.from_pretrained
+
+    def config_lookup(path, *args, **kwargs):
+        if str(path) == "__tiny_rldx_backbone__":
+            return SimpleNamespace()
+        return original(path, *args, **kwargs)
+
+    AutoConfig.register(TinyConfig.model_type, TinyConfig, exist_ok=True)
+    AutoModel.register(TinyConfig, TinyPolicy, exist_ok=True)
+    with patch.object(AutoConfig, "from_pretrained", config_lookup), patch.object(adapter, "VTC_Qwen3VL", TinyVTC), patch.object(modeling_vtc, "LayerWrapper", lambda layer, **kwargs: layer):
+        yield
+
+
+def checkpoint(tmp_path, **config):
+    model = TinyPolicy(TinyConfig(**config)).to(torch.bfloat16)
+    model.save_pretrained(tmp_path, safe_serialization=True)
+    return tmp_path
+
+
+def _check_real_hf_load_uses_inference_dtype_without_changing_checkpoint(tmp_path, fp32_flag, full_tuning):
+    path = checkpoint(tmp_path, tune_llm=full_tuning, tune_visual=full_tuning)
+    config_path = path / "config.json"
+    config = json.loads(config_path.read_text())
+    if fp32_flag == "missing":
+        config.pop("backbone_trainable_params_fp32", None)
+    else:
+        config["backbone_trainable_params_fp32"] = fp32_flag
+    config_path.write_text(json.dumps(config))
+    before = config_path.read_bytes()
+    loaded = loader._load_model(path, "cpu", False)
+    assert loaded.config.backbone_trainable_params_fp32 is False
+    assert not loaded.training
+    for name, parameter in loaded.named_parameters():
+        expected = torch.float32 if "motion_block" in name else torch.bfloat16
+        assert parameter.dtype == expected, (name, parameter.dtype)
+        assert parameter.device.type == "cpu"
+    assert loaded.backbone.qwen_model.integer_marker.dtype == torch.int64
+    assert loaded.backbone.qwen_model.model.visual.motion_block[0].running_mean.dtype == torch.float32
+    assert config_path.read_bytes() == before
+
+
+def _check_memory_override_reaches_loaded_model(tmp_path, use_memory, concat_memory, deactivate):
+    path = checkpoint(tmp_path, use_memory=use_memory, concat_memory=concat_memory)
+    loaded = loader._load_model(path, "cpu", deactivate)
+    assert loaded.config.use_memory is (False if deactivate else use_memory)
+    assert loaded.config.concat_memory is (False if deactivate else concat_memory)
+
+
+def _check_training_constructor_and_reload_keep_fp32_master_parameters(tmp_path):
+    path = checkpoint(tmp_path, backbone_trainable_params_fp32=True)
+    loader._load_model(path, "cpu", False)
+    direct = TinyPolicy(TinyConfig(backbone_trainable_params_fp32=True))
+    reloaded = AutoModel.from_pretrained(path, device_map="cpu", torch_dtype=torch.bfloat16)
+    for model in [direct, reloaded]:
+        embedding = model.backbone.qwen_model.model.language_model.embed_tokens
+        assert embedding.weight.dtype == torch.float32
+        assert embedding.weight.requires_grad
+        embedding(torch.tensor([1, 2])).sum().backward()
+        assert torch.isfinite(embedding.weight.grad).all()
+    assert AutoConfig.from_pretrained(path).backbone_trainable_params_fp32 is True
+
+class PolicyLoaderInferencePrecisionTest(unittest.TestCase):
+    pass
+
+
+def add_case(fn, *args):
+    def run(self):
+        with tempfile.TemporaryDirectory(prefix="rldx-precision-", dir="/dev/shm") as tmp, tiny_backbone():
+            fn(Path(tmp), *args)
+    suffix="_".join(str(a).lower() for a in args)
+    name="test_"+fn.__name__.removeprefix("_check_")+("_"+suffix if suffix else "")
+    setattr(PolicyLoaderInferencePrecisionTest, name, run)
+
+
+for flag in [True, False, "missing"]:
+    for full in [True, False]:
+        add_case(_check_real_hf_load_uses_inference_dtype_without_changing_checkpoint, flag, full)
+for memory, concat in [(False, False), (True, False), (True, True), (False, True)]:
+    for deactivate in [False, True]:
+        add_case(_check_memory_override_reaches_loaded_model, memory, concat, deactivate)
+add_case(_check_training_constructor_and_reload_keep_fp32_master_parameters)
+
+
+if __name__ == "__main__":
+    suite=unittest.defaultTestLoader.loadTestsFromTestCase(PolicyLoaderInferencePrecisionTest)
+    result=unittest.TextTestRunner(verbosity=2).run(suite)
+    report={"tests":result.testsRun,"failures":len(result.failures),"errors":len(result.errors),"successful":result.wasSuccessful(),"loader":loader.__file__}
+    if os.environ.get("RLDX_TEST_REPORT"):
+        Path(os.environ["RLDX_TEST_REPORT"]).write_text(json.dumps(report,indent=2))
+    sys.exit(0 if result.wasSuccessful() else 1)
